{
  "appId": "com.intonome.app",
  "appName": "Intonome",
  "webDir": "dist",
  "backgroundColor": "#181b21",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "minWebViewVersion": 94,
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK"
    },
    "SplashScreen": {
      "backgroundColor": "#0b0c0f",
      "launchAutoHide": false,
      "launchFadeOutDuration": 150
    }
  }
}
